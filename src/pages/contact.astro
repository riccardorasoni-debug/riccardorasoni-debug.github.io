---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---
<BaseLayout title="Contact | Riccardo Rasoni" description="Get in touch with Riccardo Rasoni, Economics PhD candidate at the University of Padua.">
  <section class="page-intro site-shell contact-intro"><p class="kicker">Contact</p><h1>Get in touch.</h1><p>For questions about my work, collaborations, or academic discussions, email is the best way to reach me.</p></section>
  <section class="site-shell contact-panel">
    <span class="kicker">Email</span>
    <a class="email-big" href={`mailto:${SITE.email}`}>{SITE.email}<span aria-hidden="true">↗</span></a>
    <div class="contact-lower"><span>Padua, Italy</span><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
