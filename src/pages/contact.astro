---
import BaseLayout from '../layouts/BaseLayout.astro';
import GithubIcon from '../components/GithubIcon.astro';
import { SITE } from '../lib/site';
---
<BaseLayout title="Contact | Riccardo Rasoni" description="Get in touch with Riccardo Rasoni, Economics PhD candidate at the University of Padua.">
  <section class="page-intro site-shell contact-intro"><p class="kicker">Contact</p><h1>Get in touch.</h1><p>For questions about my work, collaborations, or academic discussions, email is the best way to reach me.</p></section>
  <section class="site-shell contact-panel">
    <div class="contact-email">
      <span class="kicker">Institutional email</span>
      <a class="email-big" href={`mailto:${SITE.email}`}>{SITE.email}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="contact-email">
      <span class="kicker">Personal email</span>
      <a class="email-big" href={`mailto:${SITE.personalEmail}`}>{SITE.personalEmail}<span aria-hidden="true">↗</span></a>
    </div>
    <a class="contact-github" href={SITE.github} target="_blank" rel="noopener noreferrer"><span class="icon-label"><GithubIcon /> GitHub</span><span>github.com/riccardorasoni-debug</span><b aria-hidden="true">↗</b></a>
    <div class="contact-lower"><span>Padua, Italy</span></div>
  </section>
</BaseLayout>
