---
import BaseLayout from '../layouts/BaseLayout.astro';
import GithubIcon from '../components/GithubIcon.astro';
import { SITE } from '../lib/site';
---
<BaseLayout>
  <section class="home-intro site-shell">
    <p class="home-statement"><em>I’m an economist interested in how people make sense of the economy.</em></p>
    <figure class="home-portrait">
      <img src="/images/riccardo-rasoni.webp" alt="Riccardo Rasoni at his desk" width="900" height="1125" />
    </figure>
    <div class="hero-copy">
      <p class="kicker">Economics · Padua, Italy</p>
      <h1>Riccardo Rasoni</h1>
      <p class="hero-lead">I’m a PhD candidate in Economics at the University of Padua. I study how households form expectations, interpret economic information, and respond to change.</p>
      <nav class="home-links" aria-label="Explore the website">
        <a href="/research/"><span>Research</span><small>Working papers</small><b aria-hidden="true">↗</b></a>
        <a href="/about/"><span>About</span><small>Profile and CV</small><b aria-hidden="true">↗</b></a>
        <a href="/contact/"><span>Contact</span><small>Write to me</small><b aria-hidden="true">↗</b></a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer"><span class="icon-label"><GithubIcon /> GitHub</span><small>Code profile</small><b aria-hidden="true">↗</b></a>
      </nav>
    </div>
  </section>
</BaseLayout>
